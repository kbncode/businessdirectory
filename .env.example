# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# --- Database (Vercel Postgres) ---
# Pooled connection string, used by the app at runtime.
# In the Vercel dashboard this is exposed as POSTGRES_PRISMA_URL.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection string, used by Prisma Migrate.
# In the Vercel dashboard this is exposed as POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- File uploads (Vercel Blob) ---
# Read/write token for the Vercel Blob store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# --- Auth (NextAuth.js / Auth.js v5) ---
# Secret used to sign/encrypt session JWTs for both the viewer and admin
# auth instances. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32-output"

# Canonical URL of this app, used by NextAuth for callback/redirect URLs.
NEXTAUTH_URL="http://localhost:3000"

# --- Email (Resend) ---
# API key for sending transactional emails. Get one at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address for outgoing emails. The default below is Resend's shared
# sandbox sender, which can only deliver to the email verified on your
# Resend account — swap this once you verify a custom domain in Resend.
EMAIL_FROM="KBN Business Directory <onboarding@resend.dev>"

# --- Rate limiting (Upstash Redis) ---
# Create a free Redis database at vercel.com/marketplace (Upstash integration)
# or upstash.com, then copy these from the REST API section.
# Without these set, rate limiting falls back to an in-process in-memory
# limiter — fine for local dev, but not shared across serverless instances,
# so a real Upstash database is required in production.
UPSTASH_REDIS_REST_URL="https://xxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- App ---
# Base URL of the deployed app, used for links in emails etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
