// KBN Business Directory — Prisma schema (draft for Step 2)
// Provider: Vercel Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Accounts ----------

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  businesses    Business[]           @relation("SubmittedBy")
  accounts      Account[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  promotions    Promotion[]

  // Set once, at the moment credentials are verified (lib/auth-viewer.ts's
  // authorize()) — distinct from lastActiveAt below since a JWT session
  // stays valid for ~30 days without re-authenticating, so "last logged in"
  // and "last active" are genuinely different facts. Nullable because
  // existing users have never had a real login event recorded.
  lastLoginAt  DateTime?
  // Touched (throttled) on every page load while signed in — see
  // lib/viewer-activity.ts. Used only as a short-window "currently online"
  // presence signal for the admin dashboard's live user count, not a
  // precise session record.
  lastActiveAt DateTime?

  @@map("users")
}

// ---------- Auth (NextAuth.js / Auth.js v5 — viewer/owner flow) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Admin {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  heroImages   HeroImage[]

  @@map("admins")
}

model HeroImage {
  id             String   @id @default(cuid())
  imageUrl       String
  altText        String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  originalSizeKb Int?
  width          Int?
  height         Int?
  uploadedById   String
  uploadedBy     Admin    @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("hero_images")
}

// ---------- Master data ----------

model Country {
  id         String     @id
  name       String     @unique
  states     State[]
  businesses Business[]

  @@map("countries")
}

model State {
  id         String     @id
  name       String
  countryId  String
  country    Country    @relation(fields: [countryId], references: [id])
  cities     City[]
  businesses Business[]

  @@index([countryId])
  @@map("states")
}

model City {
  id      String @id
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  homeFeature HomeCityFeature?

  @@index([stateId])
  @@index([name])
  @@map("cities")
}

model HomeCityFeature {
  id        String   @id @default(cuid())
  cityId    String   @unique
  city      City     @relation(fields: [cityId], references: [id])
  iconUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("home_city_features")
}

model BusinessEntity {
  id         String     @id
  name       String     @unique
  businesses Business[]

  @@map("business_entities")
}

model BusinessType {
  id         String     @id
  name       String     @unique
  businesses Business[]

  @@map("business_types")
}

model BusinessMainCategory {
  id            String                @id
  name          String                @unique
  subCategories BusinessSubCategory[]
  businesses    Business[]

  @@map("business_main_categories")
}

model BusinessSubCategory {
  id             String                   @id
  name           String
  mainCategoryId String
  mainCategory   BusinessMainCategory     @relation(fields: [mainCategoryId], references: [id])
  businesses     BusinessSubCategoryMap[]

  @@index([mainCategoryId])
  @@map("business_sub_categories")
}

// ---------- Core listing ----------

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

model Business {
  id String @id @default(cuid())

  submittedById String
  submittedBy   User   @relation("SubmittedBy", fields: [submittedById], references: [id])

  // Generated once from businessName at creation time (see lib/slug.ts) and
  // never auto-regenerated on edit — a listing's public URL has to stay
  // stable even after the owner renames the business, or every shared
  // link/bookmark/search-engine result for it breaks.
  slug            String  @unique
  ownerName       String
  businessName    String
  establishedYear Int?
  businessPhone   String
  personalPhone   String?
  email           String?
  website         String?

  entityId String
  entity   BusinessEntity @relation(fields: [entityId], references: [id])

  typeId String
  type   BusinessType @relation(fields: [typeId], references: [id])

  mainCategoryId String
  mainCategory   BusinessMainCategory     @relation(fields: [mainCategoryId], references: [id])
  subCategories  BusinessSubCategoryMap[]

  countryId   String
  country     Country @relation(fields: [countryId], references: [id])
  stateId     String?
  state       State?  @relation(fields: [stateId], references: [id])
  city        String
  area        String?
  nativePlace String?
  address     String?

  about            String?
  productsServices String?
  experience       String?
  socialLinks      String?

  photoUrl       String?
  brochureUrl    String?
  additionalNote String?

  status          BusinessStatus @default(PENDING)
  rejectionReason String?

  // Home page "Featured listings" — admin-controlled, auto-expires. A row
  // only actually shows once status: APPROVED AND isFeatured AND the
  // current time falls within [featuredStartDate, featuredEndDate] (either
  // bound may be null/open-ended) — see getFeaturedBusinesses. No cron job
  // needed to "remove" an expired feature; the query filter handles it.
  isFeatured        Boolean   @default(false)
  featuredStartDate DateTime?
  featuredEndDate   DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  // Generated tsvector column (businessName/about/productsServices), kept in
  // sync by Postgres itself — see the add_search_and_indexes migration for
  // the GENERATED ALWAYS AS ... STORED definition and its GIN index. Prisma
  // can't express a generated column, so it's read-only from the client and
  // only ever queried via $queryRaw in lib/queries/business.ts.
  searchVector Unsupported("tsvector")?

  promotions Promotion[]
  views      BusinessView[]

  @@index([countryId, stateId, city, status])
  @@index([mainCategoryId, status])
  @@index([submittedById])
  @@index([status, createdAt])
  @@index([isFeatured, status])
  @@map("businesses")
}

model BusinessSubCategoryMap {
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subCategoryId String
  subCategory   BusinessSubCategory @relation(fields: [subCategoryId], references: [id])

  @@id([businessId, subCategoryId])
  @@index([subCategoryId])
  @@map("business_sub_category_map")
}

// ---------- Static content ----------

model AppMessage {
  key  String @id
  text String

  @@map("app_messages")
}

// ---------- CMS ----------

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum PageType {
  ABOUT
  CUSTOM
}

model Page {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  content        String // rich text stored as HTML
  type           PageType   @default(CUSTOM)
  status         PageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("pages")
}

enum MenuLinkType {
  PAGE
  EXTERNAL
  SYSTEM
}

model HeaderMenuItem {
  id           String       @id @default(cuid())
  label        String
  linkType     MenuLinkType
  pageSlug     String? // when linkType = PAGE
  systemRoute  String? // when linkType = SYSTEM (e.g. "/browse", "/gallery", "/events", "/contact")
  externalUrl  String? // when linkType = EXTERNAL
  openInNewTab Boolean      @default(false)
  isCta        Boolean      @default(false)
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)

  @@index([isActive, sortOrder])
  @@map("header_menu_items")
}

model FooterLink {
  id        String  @id @default(cuid())
  section   String // e.g. "Company", "Social", "Quick Links"
  label     String
  url       String
  icon      String? // lucide icon name, mainly for social links
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([section, sortOrder])
  @@map("footer_links")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@map("contact_submissions")
}

model GalleryImage {
  id             String   @id @default(cuid())
  imageUrl       String
  caption        String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  width          Int?
  height         Int?
  originalSizeKb Int?
  createdAt      DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("gallery_images")
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

model Event {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String
  eventDate    DateTime
  endDate      DateTime?
  location     String?
  photoUrl     String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  isFeatured   Boolean     @default(false)
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, eventDate])
  @@index([isFeatured, status])
  @@map("events")
}

// ---------- Promotions (offers / advertisements / campaigns) ----------

enum PromotionType {
  OFFER
  ADVERTISEMENT
  CAMPAIGN
}

enum PromotionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REMOVED
}

model Promotion {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])

  type        PromotionType
  title       String
  description String
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  details     Json // type-specific fields, shape depends on `type`

  status          PromotionStatus @default(PENDING)
  rejectionReason String?
  sortOrder       Int?
  approvedAt      DateTime?
  removedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PromotionEvent[]

  @@index([status, endDate])
  @@index([businessId, status])
  @@map("promotions")
}

// ---------- View / event tracking ----------

enum PromotionEventType {
  IMPRESSION
  CLICK
}

model BusinessView {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitorKey String
  viewDate   DateTime // truncated to date (midnight UTC)
  createdAt  DateTime @default(now())

  @@unique([businessId, visitorKey, viewDate])
  @@index([businessId, viewDate])
  @@map("business_views")
}

model PromotionEvent {
  id          String             @id @default(cuid())
  promotionId String
  promotion   Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  eventType   PromotionEventType
  visitorKey  String
  eventDate   DateTime // truncated to date
  createdAt   DateTime           @default(now())

  @@unique([promotionId, eventType, visitorKey, eventDate])
  @@index([promotionId, eventType, eventDate])
  @@map("promotion_events")
}

// Site-wide visit tracking for the admin dashboard's visitor stats — same
// visitor-key + day dedup shape as BusinessView, just without a businessId
// since this counts a hit on any public page, not one business's listing.
model SiteVisit {
  id         String   @id @default(cuid())
  visitorKey String
  viewDate   DateTime // truncated to date (midnight UTC)
  createdAt  DateTime @default(now())

  @@unique([visitorKey, viewDate])
  @@index([viewDate])
  @@map("site_visits")
}
